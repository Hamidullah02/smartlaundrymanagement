@model LaundryMVC.Models.ResetPasswordForm
@{
    ViewData["Title"] = "Set new password";
    Layout = "_Layout";
}
<div class="auth-wrap">
    <div class="card auth-card" style="padding:28px;max-width:420px">
        <h2 style="margin:0 0 6px">Set a new password</h2>
        <p style="color:#475569;margin:0 0 18px">
            Code verified for <strong>@Model.Email</strong>. Choose a new password.
        </p>
        <form method="post" action="/Home/ResetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@Model.Email" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label>New password <input name="Password" type="password" required minlength="6" /></label>
            <label>Confirm password <input name="Confirm" type="password" required minlength="6" /></label>
            <button class="btn primary" type="submit">Update password</button>
        </form>
    </div>
</div>
