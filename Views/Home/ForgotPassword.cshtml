@model LaundryMVC.Models.OtpVerifyForm
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_Layout";
    Model.Purpose = "reset";
}
<div class="auth-wrap">
    <div class="card auth-card" style="padding:28px;max-width:420px">
        <h2 style="margin:0 0 6px">Forgot your password?</h2>
        <p style="color:#475569;margin:0 0 18px">
            Enter your account email and we'll send a 6-digit code to reset your password.
        </p>
        <form method="post" action="/Home/ForgotPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Purpose" value="reset" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label>Email <input name="Email" type="email" required value="@Model.Email" /></label>
            <button class="btn primary" type="submit">Send code</button>
        </form>
        <p style="text-align:center;margin-top:14px"><a href="/">Back to login</a></p>
    </div>
</div>
